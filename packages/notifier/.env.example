# discord-mcp 通知Bot の設定。このファイルを .env にコピーして埋める（.env は git に入らない）。

# ---- Discord ----
# Developer Portal の Bot ページで発行したトークン。MCP サーバーと同じものを使う
DISCORD_BOT_TOKEN=
# 通知の対象になる人（あなた）のユーザーID。Discord の設定 > 詳細設定 > 開発者モード をオンにして、自分を右クリック >「ユーザーIDをコピー」
TARGET_USER_ID=
# 見るサーバーを限る（カンマ区切り）。空なら Bot が入っている全サーバー
ALLOWED_GUILD_IDS=
# 見ないチャンネル（カンマ区切り）。スレッドは親チャンネルの指定で一緒に外れる
IGNORE_CHANNEL_IDS=
# 含まれていたらメンションと同じ扱いで知らせる語（カンマ区切り、大文字小文字は区別しない）。例: Alice,アリス
KEYWORDS=
# 他の Bot や Webhook の投稿も見る
INCLUDE_BOT_MESSAGES=false
# この Bot 自身へのメンションも知らせる
NOTIFY_BOT_MENTIONS=true
# @everyone / @here をすぐ知らせる（false なら判定モデルに任せる）
NOTIFY_EVERYONE=false
# メンションの通知に添える直前の会話の件数（0〜20）
MENTION_CONTEXT_MESSAGES=5

# ---- 判定モデル（メンション以外の投稿が自分に関係ありそうかを判断する）----
# none / clef / openrouter / openai-compatible / anthropic（未設定なら none）
#   none（既定）: 判定せず、見られるチャンネルのすべての投稿を知らせる（通知が多くなる）。プロフィールは要らない
#   clef: Cloudflare Workers AI の判定モデル Clef。データを残さない（ZDR）。1日 10,000 Neurons の無料枠がある
#   openrouter: OpenRouter 経由のモデル（既定 google/gemini-3.5-flash-lite）
#   openai-compatible: LM Studio・Ollama など、/chat/completions を話すサーバー
#   anthropic: Claude の API
DECISION_PROVIDER=none

# clef の設定（DECISION_PROVIDER=clef にしたとき）。モデルは clef-flash（既定、安い）か clef（大きい）
DECISION_MODEL=clef-flash
# Cloudflare のアカウントID（ダッシュボードの Workers AI >「REST API を使う」に出る）
CLOUDFLARE_ACCOUNT_ID=
# 「Workers AI の API トークンを作成」で作ったトークン（Workers AI の権限だけ）
CLOUDFLARE_AI_TOKEN=
# 関係ありの確率がこれ以上なら知らせる（0〜1、既定 0.3）。知らせが多すぎたら上げ、少なすぎたら下げる。
# 値の決め方は bun run eval で試せる（Discord に投稿しなくてよい）
CLEF_THRESHOLD=0.3
# 重要度（0〜3）がこれ以上なら、確率が足りなくても知らせる（既定 1.0）。4 にすると重要度では知らせない
CLEF_PRIORITY_THRESHOLD=1.0

# openrouter の例
# DECISION_PROVIDER=openrouter
# DECISION_MODEL=google/gemini-3.5-flash-lite
# DECISION_API_KEY=
# true: ZDR と「安全のための保持（Safety Retention）」のエンドポイントだけに送る（学習に使うところには送らない）。
#   Gemini（Google Vertex）は Safety Retention なので、OpenRouter のプライバシー設定で Google のモデルに
#   「Allow Safety Retention」を選んでおく（個人のアカウントは最初からこれ）。Vertex の鍵を BYOK で登録していれば、それが優先して使われる
# false: 保持の条件を外す（データを集めるプロバイダーには送らない）
# OPENROUTER_ZDR=true

# openai-compatible の例（LM Studio をサブPCで動かしている場合）
# DECISION_PROVIDER=openai-compatible
# DECISION_BASE_URL=http://<LM Studio を動かしているPCのアドレス>:1234/v1
# DECISION_MODEL=<LM Studio に読み込んだモデル名>
# サーバーが json_schema に対応していなければ json_object か none にする（openrouter / openai-compatible）
DECISION_JSON_MODE=json_schema

# anthropic の例
# DECISION_PROVIDER=anthropic
# DECISION_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=

# あなたの担当や関心。判定モデルはこれを読んで判断する（none 以外では必須）。長ければファイルに書いて DECISION_PROFILE_FILE で指定。
# 名前の呼ばれ方（Discord の表示名・あだ名・カタカナ）、担当、関わっているもの、知りたいことと知らなくてよいことを書くと判定が良くなる。
# 書き方の例は eval/profile.example.md
DECISION_PROFILE=
DECISION_PROFILE_FILE=
# 判定に渡す直近の会話の件数（1〜100）
DECISION_HISTORY_MESSAGES=20
# 投稿の画像（添付・埋め込み。新しい投稿を優先して4枚まで、Discord の CDN のものだけ）を判定モデルに渡す。
# 画像を読めないモデルなら false にする（断られたときは画像なしでやり直す）
DECISION_IMAGES=true
# 同じチャンネルの投稿は、最後の投稿からこの秒数だけ静かになってからまとめて判定する
DECISION_DEBOUNCE_SECONDS=20
# 投稿が続いても、最初の投稿からこの秒数で必ず判定する
DECISION_MAX_WAIT_SECONDS=120
# 判定モデルの呼び出しの時間切れ（秒）
DECISION_TIMEOUT_SECONDS=60

# ---- Claude Duet への通知（duet-send）----
# duet-send の send.ts のフルパス
DUET_SEND_PATH=/home/<you>/duet-send/send.ts
# Duet で通知を見分けるタグ
DUET_TAG=[Discord]
# サーバー・チャンネルごとに Duet の宛先を振り分ける（任意）。「ID=宛先名」をカンマで並べる。
# ID は Discord のサーバーIDかチャンネルID（スレッドは親チャンネルのIDで指定できる）。チャンネル → スレッドの親 → サーバー の順に探す。
# 載っていないサーバー・チャンネルの通知と、この Bot 自身のお知らせは、duet-send の既定の宛先に送る。
# 宛先名は duet-send の routes 表にある名前にする（空白・カンマ・= を含めず、- で始めない）。
# duet-send 側が --to に対応し、DUET_ROUTES_FILE_ID を設定してあることも必要。bun run check で宛先ごとに確かめられる
# ID はサーバーID・チャンネルID・スレッドの親チャンネルIDのどれか（カテゴリのIDは一致しない）。
# duet-send の既定の宛先の名前はここに書かない（載っていないサーバーは元から既定へ行き、書くと同じセッション向けのキューが2つできる）。
# DUET_ROUTES=<サーバーID>=work,<別のサーバーID>=school
# Duet への送信の最短間隔（秒）。その間に溜まった通知は1通にまとめる
NOTIFY_MIN_INTERVAL_SECONDS=30
# true なら Duet に送らず、ログに出すだけ（試運転用）
DUET_DRY_RUN=false

# duet-send は duet-send のフォルダで起動するので、duet-send 側の .env も読まれる。
# この .env に書いた値も渡る（DISCORD_BOT_TOKEN と API キーは渡さない）。サービスでは claude のフルパスを書くと確実
# DUET_CLAUDE_BIN=/home/<you>/.local/bin/claude

# debug にすると、無視した投稿の理由（dm / guild / channel / self など。本文は出さない）もログに出す
LOG_LEVEL=info
